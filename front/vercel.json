{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "application/octet-stream" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/models/:path*",
      "destination": "/models/:path*"
    },
    {
      "source": "/((?!models/).*)",
      "destination": "/"
    }
  ]
}
